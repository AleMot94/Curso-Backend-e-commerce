<h1>Products</h1>
<div class="products-grid">
    {{#each products}}
        <article class="product-card">
            <img src="{{this.thumbnail}}" alt="{{this.title}}">
            <h2>{{this.title}}</h2>
            <p>{{this.description}}</p>
            <p>Precio: ${{this.price}}</p>
            <p>Stock: {{this.stock}}</p>
            <p>Código: {{this.code}}</p>
            <button class="add-to-cart" data-id="{{this._id}}">Agregar al carrito</button>
        </article>
    {{/each}}
</div>

<nav class="pagination-bar">
    {{#if hasPrevPage}}
        <a href="?page={{prevPage}}">&laquo; Anterior</a>
    {{else}}
        <span class="disabled">&laquo; Anterior</span>
    {{/if}}

    <span>Página {{page}} de {{pages}}</span>

    {{#if hasNextPage}}
        <a href="?page={{nextPage}}">Siguiente &raquo;</a>
    {{else}}
        <span class="disabled">Siguiente &raquo;</span>
    {{/if}}
</nav>
