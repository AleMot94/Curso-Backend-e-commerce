<div>
    <h1>Products</h1>
    {{#each products}}
        <h1>{{this.title}}</h1>
        <p>{{this.description}}</p>
        <p>{{this.price}}</p>
        <p>{{this.stock}}</p>
        <p>{{this.code}}</p>
        <img src="{{this.thumbnail}}" alt="{{this.title}}">
        <br>
    {{/each}}
</div>

<nav class="pagination-bar">
    {{#if hasPrevPage}}
        <a href="?page={{prevPage}}">&laquo; Anterior</a>
    {{else}}
        <span class="disabled">&laquo; Anterior</span>
    {{/if}}

    <span>Página {{page}} de {{pages}}</span>

    {{#if hasNextPage}}
        <a href="?page={{nextPage}}">Siguiente &raquo;</a>
    {{else}}
        <span class="disabled">Siguiente &raquo;</span>
    {{/if}}
</nav>
